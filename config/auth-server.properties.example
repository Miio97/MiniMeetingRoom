# Copy to config/auth-server.properties (ignored by Git).
# Environment variables MMR_DB_URL / MMR_DB_USER / MMR_DB_PASSWORD override these values.
# Java server/client run locally; use the public Railway MySQL endpoint below.
# Replace placeholders with Railway settings. Keep real values only in the ignored file.
db.url=jdbc:mysql://RAILWAY_PUBLIC_HOST:RAILWAY_PUBLIC_PORT/RAILWAY_DATABASE?sslMode=REQUIRED
db.user=RAILWAY_USER
db.password=RAILWAY_PASSWORD

# Environment variables: MMR_AUTH_PORT, MMR_AUTH_BIND, MMR_AUTH_KEYSTORE,
# MMR_AUTH_KEYSTORE_PASSWORD, MMR_AUTH_SESSION_HOURS.
auth.port=8443
auth.bind=127.0.0.1
auth.keystore=config/auth-dev.p12
# Development only. Use a private password and a trusted certificate for deployment.
auth.keystorePassword=changeit-local-only
auth.sessionHours=24

# Apply database/migrations/001_file_transfer.sql to an existing database first.
# Separate TLS socket; same certificate as auth. Never disable TLS.
# Environment keys replace . and - with _: MMR_FILE_TRANSFER_PORT, etc.
file.transfer.enabled=true
file.transfer.bind=127.0.0.1
file.transfer.port=9001
file.transfer.tls-enabled=true
file.transfer.checksum=SHA-256
file.transfer.chunk-size=65536
file.transfer.max-file-size-mb=1024
file.transfer.storage-quota-mb=10240
file.transfer.max-concurrent-transfers=8
file.transfer.max-transfers-per-user=3
file.transfer.max-pending-per-user=4
file.transfer.socket-timeout-ms=30000
file.transfer.storage-path=storage
file.transfer.resume-enabled=true
file.transfer.expiry-hours=24
# Closed rooms are cleaned immediately by ImmediateRoomCleanup.
# Reopening is blocked until both managed files and metadata are clean.
# Includes metadata polling; increase for many clients behind one NAT address.
file.transfer.connections-per-ip-minute=600
